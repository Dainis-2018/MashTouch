# PlatformIO build output and libraries
.pio/

# Generated at build time from web/index.html (tools/embed_web.py)
src/net/webui_data.h

# PC mock state (may hold Wi-Fi and web passwords)
tools/mock/data.json

# Editor: keep only the shared build tasks
.vscode/*
!.vscode/tasks.json
*.code-workspace
compile_commands.json

# KiCad scratch and backups
*-backups/
*.kicad_prl
fp-info-cache
*.lck
_autosave-*

# Python and OS clutter
__pycache__/
Thumbs.db
desktop.ini
.DS_Store

# Vendor files (Waveshare drawings, STEP, schematic): not ours to redistribute
reference/waveshare/

# KiCad: generated reports and netlists (rebuild with kicad-cli)
hardware/**/*.rpt
hardware/**/*.net

# KiCad local history and ad-hoc upload archives
hardware/**/.history/
hardware/**/*.zip

# PCB order files (rebuild with node tools/kicad/fab_export.js)
hardware/backpack/fab/
